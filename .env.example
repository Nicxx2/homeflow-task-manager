# -----------------------------
# App / auth
# -----------------------------
APP_NAME=Simple Task Management
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
SESSION_IDLE_TIMEOUT_MINUTES=15

# -----------------------------
# Database (Docker default)
# -----------------------------
POSTGRES_DB=task_mgmt
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://task_user:task_pass@db:5432/task_mgmt

# -----------------------------
# Local AI (Ollama)
# -----------------------------
# Docker default uses internal network hostname "ollama"
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
AI_DEFAULT_TIMEOUT_SECONDS=8

# -----------------------------
# Initial admin user (seeded on first startup)
# -----------------------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin1234
